{
  "name": "dsh-we-pet-builtin",
  "version": "0.3.7",
  "description": "吃白饭的蓝色大肥鱼，赖在 DeepSeek Harness 里不走了。平时爱玩魔方、爱吃各种零食、偶尔打个盹，闲不住就在桌面上溜达两圈，被你拖来甩去也照旧赖着；你忙起来它跟着忙前忙后，也会帮你打理余额钱包，闲下来爱碎碎念，还乐意陪你唠两句。",
  "icon": "icon.png",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.2": "incompatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib",
    "!lib/pet-link-backups",
    "!lib/types",
    "src",
    "assets/webm",
    "runtime/electron-helper",
    "assets/fonts",
    "assets/pic",
    "assets/memes",
    "assets/config.jsonc",
    "assets/logo.png",
    "icon.png",
    "locale",
    "scripts/ensure-electron.mjs",
    "cordis.patch.yml",
    "package.json",
    "LICENSE",
    "README.md",
    "README.upstream.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT",
  "_derived": "dsh-pet@0.3.7 受控派生副本（wallpaper 内置子包，upstream-fork 形态）；派生自 dsh-pet（MIT，https://github.com/PC2005-cloud/dsh-pet）；固定派生身份 dsh-we-pet-builtin。派生链与逐文件哈希见 .artifacts/rebuild-20261018/pet-implementation.md 与 .artifacts/pet-builtin-stage/patch-log.md。",
  "_upstream": {
    "package": "dsh-pet",
    "version": "0.3.7",
    "tgz": ".artifacts/dsh-pet-0.3.7.tgz",
    "sha256": "4a8cefce38e66f1e9371a19080ee8d9d4bf8a31ace3b39ca05427d730e756434",
    "bytes": 62494301,
    "entries": 308,
    "license": "MIT"
  },
  "bin": {
    "dsh-we-pet-builtin-standalone": "lib/standalone.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0"
  },
  "optionalDependencies": {
    "electron": ">=28.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "js-yaml": "^5.4.2",
    "prettier": "^3.9.6",
    "react-dom": "^18.2.0",
    "rolldown": "1.0.0-beta.7",
    "tsdown": "^0.8.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "standalone": "node lib/standalone.js",
    "build": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test src/**/*.test.ts"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pet",
    "floating-widget",
    "web-ui",
    "cordis",
